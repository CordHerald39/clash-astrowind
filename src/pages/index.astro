---
import Layout from '../layouts/GuideLayout.astro';
import {getCollection} from 'astro:content';
import {href} from '../lib/site';
const posts=(await getCollection('blog',p=>!p.data.draft)).sort((a,b)=>b.data.updated.localeCompare(a.data.updated));
const platforms=[{id:'android',name:'Android',label:'安卓手机',client:'Clash Meta for Android',ext:'APK',text:'先核对手机架构，再下载 APK。安装之后导入配置，并允许客户端建立 VPN 连接。',url:'/mobile/',repo:'https://github.com/MetaCubeX/ClashMetaForAndroid/releases'}, {id:'windows',name:'Windows',label:'Windows 电脑',client:'Clash Verge Rev',ext:'EXE / MSI',text:'在系统设置中确认 x64 或 ARM64，选择对应安装包。首次配置可以从系统代理开始。',url:'/windows/',repo:'https://github.com/clash-verge-rev/clash-verge-rev/releases'}, {id:'mac',name:'macOS',label:'Mac 电脑',client:'Clash Verge Rev',ext:'DMG',text:'根据 Intel 或 Apple 芯片选择发布附件，阅读发行说明中的安装要求。',url:'/download/',repo:'https://github.com/clash-verge-rev/clash-verge-rev/releases'}];
---
<Layout title="Clash 中文社区｜客户端下载与使用教程" description="按手机与电脑系统选择 Clash 客户端，获取开发者发布入口，阅读安装配置和连接问题教程。">
<section class="g-wrap fd-intro"><div class="fd-intro-copy"><h1>Clash 中文社区<br/>客户端下载与使用教程</h1><p>安装包怎么选，订阅怎么导入，<br/>连接出问题后检查哪里。这里逐步讲清楚。</p><a class="fd-text-link" href={href('/official/')}>先了解各个客户端的下载来源</a><div class="fd-note"><span class="fd-note-dot"></span><span>下载链接前往开发者发布页<br/><small>版本与系统要求，以项目说明为准。</small></span></div></div>
<div class="device-desk"><div class="device-tabs" role="tablist" aria-label="选择设备系统">{platforms.map((p,i)=><button id={'tab-'+p.id} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={'panel-'+p.id} tabindex={i===0?0:-1} data-platform={p.id}>{p.name}</button>)}</div>{platforms.map((p,i)=><section id={'panel-'+p.id} class="device-sheet" role="tabpanel" aria-labelledby={'tab-'+p.id} hidden={i!==0}><div class="sheet-heading"><div><span class="device-label">{p.label}</span><h2>{p.client}</h2></div><span class="file-badge">{p.ext}</span></div><p>{p.text}</p><div class="package-facts"><span>下载来源<strong>开发者 GitHub 仓库</strong></span><span>准备材料<strong>兼容的配置或订阅</strong></span></div><a class="fd-download" href={p.repo}>前往发布页下载 <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"/></svg></a><a class="fd-install" href={href(p.url)}>阅读{p.label}安装指南</a></section>)}</div></section>
<div class="g-wrap fd-lower"><section class="fd-journal"><div class="fd-section-title"><h2>把配置弄明白</h2><a href={href('/blog/')}>全部文章</a></div>{posts.map(p=><article class="fd-post"><span class="fd-category">{p.data.category}</span><h3><a href={href('/blog/'+p.id+'/')}>{p.data.title}</a></h3><p>{p.data.description}</p></article>)}</section><aside class="fd-help"><h2>你可能卡在这一步</h2><a href={href('/blog/android-apk/')}><strong>手机里有好几个 APK，选哪个？</strong><span>架构和安装包</span></a><a href={href('/blog/subscription-import/')}><strong>订阅导入了，却没有开始工作。</strong><span>激活配置与节点选择</span></a><a href={href('/blog/connection-check/')}><strong>节点有延迟，网页还是打不开。</strong><span>按层检查连接</span></a><div class="fd-help-note"><h3>第一次接触 Clash？</h3><p>从下载、配置到连接检查，按顺序完成一次，再调整规则。</p><a href={href('/docs/')}>查看完整使用教程</a></div></aside></div>
<section class="g-wrap" style="padding:32px 24px"><h2>选择适合自己的机场订阅</h2><p>比较实际付款、流量周期与优惠条件，再按教程导入配置。</p><a href={href('/recommend/')}>查看机场推荐与套餐对比</a></section></Layout>
<script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-platform]'));
function activate(tab:HTMLButtonElement){for(const item of tabs){const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;const panel=document.getElementById(item.getAttribute('aria-controls')!);if(panel)panel.hidden=!active;}}
for(const tab of tabs){tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',event=>{let next=tabs.indexOf(tab);if(event.key==='ArrowRight')next=(next+1)%tabs.length;else if(event.key==='ArrowLeft')next=(next+tabs.length-1)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(tabs[next]);tabs[next].focus();});}
</script>
